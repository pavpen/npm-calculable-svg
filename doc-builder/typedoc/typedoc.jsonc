{
  "entryPoints": ["../../src/index.ts"],
  "tsconfig": "../../tsconfig.json",
  "name": "🏗Calculable SVG SDK",
  "entryPointStrategy": "Expand",
  "out": "../../dist/doc/dev",
  "includeVersion": true,
  "jsDocCompatibility": {
    "exampleTag": false
  },
  // See
  // <https://markdown-it.github.io/markdown-it/interfaces/MarkdownItOptions.html>:
  "markdownItOptions": {
    "html": true,
    "linkify": true
  },
  "customCss": "assets/extra-style.css"
}
