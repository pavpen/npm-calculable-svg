{
  "name": "@pavpen.dev/calculable-svg-browser",
  "description": "Allow limited template expressions that can calculate SVG element attributes from bounding boxes, etc.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rslib build && rspack build",
    "build-test-preview": "npm run build && npm run clean-test-preview && npm run copy-lib && npm run copy-samples && npm run copy-test-cases && npm run copy-test-case-lib",
    "clean-test-preview": "node -e \"require('fs').rmSync('./test-preview-dist', {recursive: true, force: true})\"",
    "copy-lib": "node -e \"require('fs').cpSync('./dist', './test-preview-dist/', {recursive: true})\"",
    "copy-samples": "node -e \"require('fs').cpSync('./samples', './test-preview-dist/samples', {recursive: true})\"",
    "copy-test-cases": "node -e \"require('fs').cpSync('./tests/browser/assets', './test-preview-dist/tests/browser/assets', {recursive: true})\"",
    "copy-test-case-lib": "node -e \"require('fs').cpSync('./dist/evaluate-for-current-document.js', './test-preview-dist/tests/browser/assets/evaluate-for-current-document.js')\"",
    "check": "biome check --write",
    "test-preview": "rspack dev",
    "format": "biome format --write",
    "preview": "rspack preview",
    "test:install": "playwright install --with-deps chromium",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "exports": {
    ".": "./dist/index.js",
    "./evaluate-for-current-document": "./dist/evaluate-for-current-document.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@rslib/core": "^1.0.1",
    "@rspack/cli": "^2.2.5",
    "@rspack/core": "^2.2.5",
    "@rspack/dev-server": "^2.2.1",
    "@rstest/adapter-rspack": "^0.11.12",
    "@rstest/browser": "^0.11.12",
    "@rstest/core": "^0.11.12",
    "@rstest/playwright": "^0.11.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "serve-index": "^1.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/jinja": "^0.5.10"
  }
}
