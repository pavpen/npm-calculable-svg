{
  "name": "@pavpen.dev/calculable-svg",
  "description": "Allow SVG paths, and other attributes to be calculated live in a browser from from bounding boxes, computed style, and other element properties",
  "homepage": "https://github.com/pavpen/npm-calculable-svg#readme",
  "bugs": {
    "url": "https://github.com/pavpen/npm-calculable-svg/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavpen/npm-calculable-svg.git"
  },
  "license": "MIT",
  "author": "Pavel M. Penev",
  "version": "0.0.0-alpha.0-9-g0f01718-dirty",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "rslib build && rspack build",
    "build-test-preview": "npm run build && npm run clean-test-preview && npm run copy-lib && npm run copy-examples && npm run copy-test-cases && npm run copy-test-case-lib",
    "build-test-debug-preview": "npm run build && npm run clean-test-preview && npm run copy-lib && npm run copy-examples && npm run copy-test-cases && npm run copy-test-case-debug-lib",
    "clean-test-preview": "node -e \"require('fs').rmSync('./test-preview-dist', {recursive: true, force: true})\"",
    "clean": "node -e \"require('fs').rmSync('./dist', {recursive: true, force: true})\"",
    "copy-lib": "node -e \"require('fs').cpSync('./dist', './test-preview-dist/', {recursive: true})\"",
    "copy-examples": "node -e \"require('fs').cpSync('./examples', './test-preview-dist/examples', {recursive: true})\"",
    "copy-test-cases": "node -e \"require('fs').cpSync('./tests/browser/assets', './test-preview-dist/tests/browser/assets', {recursive: true})\"",
    "copy-test-case-lib": "node -e \"const fs = require('fs'); fs.cpSync('./dist/evaluate-for-current-document.js', './test-preview-dist/tests/browser/assets/evaluate-for-current-document.js'); fs.cpSync('./dist/evaluate-for-current-document.js.map', './test-preview-dist/tests/browser/assets/evaluate-for-current-document.js.map')\"",
    "copy-test-case-debug-lib": "node -e \"const fs = require('fs'); fs.cpSync('./dist/evaluate-for-current-document-debug.js', './test-preview-dist/tests/browser/assets/evaluate-for-current-document.js'); fs.cpSync('./dist/evaluate-for-current-document-debug.js.map', './test-preview-dist/tests/browser/assets/evaluate-for-current-document.js.map')\"",
    "check": "biome check --write",
    "test-preview": "rspack dev",
    "format": "biome format --write",
    "preview": "rspack preview",
    "test:install": "playwright install --with-deps chromium",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "update-packages:lib": "npm-check-updates --packageManager=npm --upgrade --cooldown=21d --doctor --install=always",
    "update-packages:doc-builder": "cd doc-builder/typedoc && npm-check-updates --packageManager=npm --upgrade --cooldown=21d --doctor --install=always",
    "update-packages": "npm run update-packages:lib && npm run update-packages:doc-builder",
    "build-changelog": "git-cliff",
    "npm:update-version": "node scripts/update-packagejs-version.ts",
    "doc:install": "cd doc-builder/typedoc && npm install",
    "doc:build": "npm run build && npm run npm:update-version && cd doc-builder/typedoc && npm run build-doc",
    "doc:build-versioned": "npm run doc:build && node scripts/move-doc-to-version-dir.ts",
    "doc:build-all-versions": "npm run build && cd doc-builder/typedoc && npm run build-all-doc-versions"
  },
  "exports": {
    ".": "./dist/index.js",
    "./evaluate-for-current-document": "./dist/evaluate-for-current-document.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@rslib/core": "^1.0.3",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/dev-server": "^2.2.1",
    "@rstest/adapter-rspack": "^0.12.3",
    "@rstest/browser": "^0.12.3",
    "@rstest/core": "^0.12.3",
    "@rstest/playwright": "^0.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "fast-xml-parser": "^5.11.2",
    "happy-dom": "^21.0.4",
    "npm-check-updates": "^23.1.1",
    "playwright": "^1.63.0",
    "serve-index": "^1.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/jinja": "^0.5.10"
  }
}
